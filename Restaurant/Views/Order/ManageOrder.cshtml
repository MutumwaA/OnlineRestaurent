@model List<Restaurant.Models.OrderDetailsViewModel.OrderDetailsViewModel>
@using Restaurant.Utility
@{
    ViewData["Title"] = "ManageOrder";
}

<h2>Manage Order</h2>
<form method="post">
    <br />
    @if (Model.Count > 0)
    {

        @foreach (var item in Model)
        {
            <di class="container row">
                <div class=" col-10">
                    @Html.Partial("_IndividualOrderDetails",item)
                </div>
                <div class="col-2">
                    @if (item.OrderHeader.Status.Equals(SD.StatusSubmitted))
                    {
                        <button type="submit" asp-action="OrderPrepare" asp-route-orderId="@item.OrderHeader.Id" class="btn btn-primary">Start Cooking</button>
                        <button type="submit" asp-action="Ordercancel" asp-route-orderId="@item.OrderHeader.Id" class="btn btn-danger">Cancel Order</button>

                    }

                    else
                    {
                        @if (item.OrderHeader.Status.Equals(SD.StatusInProcess))
                        {
                            <button type="submit" asp-action="OrderReady" asp-route-orderId="@item.OrderHeader.Id" class="btn btn-primary">Order Prepared</button>
                            <button type="submit" asp-action="Ordercancel" asp-route-orderId="@item.OrderHeader.Id" class="btn btn-danger">Cancel Order</button>
                        }


                    }

                    </div>

            </di>
        }

    }

    else


    {
        <p> No order is  currently available</p>
     }
</form>

