@model Restaurant.Models.OrderDetailsViewModel.OrderDetailsCart
@{
    ViewData["Title"] = "Index";
}

<form method="post">
    <h2>Your Shopping Cart</h2>
    <br />

    @if (Model.ListCart.Count > 0)
    {
        <input id="userId" asp-for="@Model.ListCart[0].ApplicationUserId" hidden />
        <div class="border border-info" style="padding:15px">
            <div class="container">
                <table class="table table-striped" width="100%">
                    <tr>
                        <th></th>
                        <th style="width:70px;text-align:center">
                            <label asp-for="@Model.ListCart.FirstOrDefault().MenuItem.Price"></label>
                        </th>
                        <th style="width:70px;text-align:center">
                            <label asp-for="@Model.ListCart.FirstOrDefault().Count"></label>
                        </th>
                        <th></th>
                    </tr>
                    @foreach (var item in Model.ListCart)
                    {
                        <tr style="padding:50px">
                            <td>
                                <b>
                                    <b style="color:dodgerblue">@Html.DisplayFor(l => item.MenuItem.Name)</b>
                                    <br />
                                    @Html.DisplayFor(l => item.MenuItem.Description)
                                </b>
                            </td>
                            <td style="width:70px;text-align:center">
                                @Html.DisplayFor(l => item.MenuItem.Price)
                            </td>
                            <td style="width:70px;text-align:center">
                                @Html.DisplayFor(l => item.Count)
                            </td>

                            <td>
                                <button type="submit" class="btn btn-primary" asp-action="plus" asp-route-cartId="@item.Id">
                                    +
                                </button>
                                <button type="submit" class="btn btn-danger" asp-action="minus" asp-route-cartId="@item.Id">
                                    -
                                </button>
                            </td>
                        </tr>


                    }


                </table>

            </div>
            <hr />
            <div class="container">
                <div class="row">
                    <div class="col-2"> <label class="custom-label">Coupon code:</label></div>
                    <div class="col-2"><input asp-for="@Model.OrderHeader.CouponCode" id="txtCouponCode" class="form-control" /></div>
                    <div class="col-2"><input type="button" value="Apply" id="btnCoupon" class="btn btn-sm btn-success" /></div>
                    <a asp-action="Index" asp-controller="Cart" id="btnRemoveCoupon" class="btn btn-sm btn-success" style="display:none">Remove</a>
                </div>

                <div class="row">
                    <div class="col-2"><label class="custom-label">Order Total:</label></div>
                    <div class="col-3"><input asp-for="@Model.OrderHeader.OrderTotal" readonly id="txtOrderTotal" class="form-control" /></div>
                    <div class="col-2"></div>
                    <div class="col-2"><label class="custom-label">Pick Up Time:</label></div>
                    <div class="col-3"><input asp-for="@Model.OrderHeader.PickUpTime" id="timepicker" type="text" value="" class="form-control" /></div>
                </div>

                <div class="row">
                    <div class="col-2"><label class="custom-label">Comments:</label></div>
                    <div class="col-10"><textarea asp-for="@Model.OrderHeader.Comments" style="height:100px;" class="form-control"></textarea></div>
                </div>

                <div class="row">
                    <div class="col-2"></div>
                    <div class="col-5"> <label class="text-danger" id="lblShopClosed" style="display:none">Restaurant is closed for the day</label></div>
                    <div class="col-5 text-right"><button type="submit" id="btnPlaceOrder" onclick="return validateInput()" value="Place Order" class=" btn btn-success">Place Order</button></div>
                </div>


            </div>
        </div>
    }
    else
    {
        <div>No items added to the shopping cart....... </div>
    }
</form>


@section Scripts{

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-timepicker/1.10.0/jquery.timepicker.js"></script>
    <script>
        function validateInput() {
            var time = document.getElementById('#timepicker').value;
            if (time.toString() == null) {
                return false;
            }

            else {
                return true;
            }
        }

        $(document).ready(function () {

            var curDt = new Date();
            //12pm -10pm
            var minTime = "";
            if (curDt.getHours() < 11) {
                minTime = '12:00pm'

            }

            else {
                if (curDt.getMinutes() < 30) {
                    minTime = (curDt.getHours() + 1).toString() + ':30pm'

                }
                else {
                    minTime = (curDt.getHours() + 2).toString() + '00pm'
                   

                }
            }

            if (curDt.getHours() > 23) {
                //No more orders
                $('#timepicker').prop('disabled', true);
                $('#lblShopClosed').show();
                $('#btnPlaceOrder').prop('disabled', true);
            }
            $('#timepicker').timepicker(
                {
                    'minTime': minTime,
                    'maxTime': '8:00pm'
                });

        });

        $("#btnCoupon").click(function()
        {
            //alert("Please select pickup timei", Date());

            var couponCode = document.getElementById("txtCouponCode").value;
            var orderTotal = document.getElementById("txtOrderTotal").value;

            $.ajax(
                {
                    url: '/API/CouponAPI?orderTotal=' + orderTotal + '&couponCode=' + couponCode,
                    type: 'GET',
                    dataType: 'text',
                    success: function (data, textStatus, xhr)
                    {
                        var splitData = data.split(":");
                        if (splitData[1] == 'E') {
                            //Error
                         

                        }
                        else
                        {

                            $('#txtOrderTotal').attr('value', splitData[0]);
                            document.getElementById("txtCouponCode").readyOnly = true;
                            document.getElementById("btnCoupon").style.display = 'none';
                            document.getElementById("btnRemoveCoupon").style.display = '';
                         }


                    }



                }
            )

         })
    </script>

}
